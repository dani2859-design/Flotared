{
  "rewrites": [
    { "source": "/panel", "destination": "/panel.html" },
    { "source": "/r/:codigo", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/panel",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://docs.google.com"
        }
      ]
    }
  ]
}
